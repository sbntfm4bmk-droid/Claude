{
  "expo": {
    "name": "ProConnect",
    "slug": "proconnect",
    "scheme": "proconnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#5B21B6"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ProConnect utilise votre position pour trouver les prestataires proches de vous."
      }
    },
    "android": {
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": ["expo-router", "expo-location"],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
